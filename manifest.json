{
  "manifest_version": 3,
  "name": "Relief",
  "version": "1.2.0",
  "description": "ChatGPT 页面陪伴提醒，并可快速发送到固定对话。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "Relief",
    "default_popup": "popup.html",
    "default_icon": "assets/mascot-mobile.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/mascot-mobile.png",
    "48": "assets/mascot-mobile.png",
    "128": "assets/mascot-mobile.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.png"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    }
  ],
  "options_page": "settings.html"
}
