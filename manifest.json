{
  "manifest_version": 3,
  "name": "Relief",
  "version": "1.0.4",
  "description": "目前支持 ChatGPT 的喝水与休息提醒扩展。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "action": {
    "default_title": "Relief",
    "default_popup": "popup.html",
    "default_icon": "assets/mascot-mobile.png"
  },
  "icons": {
    "16": "assets/mascot-mobile.png",
    "48": "assets/mascot-mobile.png",
    "128": "assets/mascot-mobile.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.png"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ]
}
