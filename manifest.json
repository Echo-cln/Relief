{
  "manifest_version": 3,
  "name": "Relief",
  "version": "1.4.0",
  "description": "可选全网页陪伴、喝水与休息提醒，以及 Relief Desktop 待办与 DDL 提醒。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Relief",
    "default_popup": "popup.html",
    "default_icon": "assets/mascot-mobile.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/mascot-mobile.png",
    "48": "assets/mascot-mobile.png",
    "128": "assets/mascot-mobile.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "options_page": "settings.html",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "minimum_chrome_version": "102"
}
